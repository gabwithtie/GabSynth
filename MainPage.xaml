<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GabSynth.ViewModels"
             x:Class="GabSynth.MainPage"
             BackgroundColor="#121216"
             Title="GabSynth Console">

	<ScrollView Padding="16">
		<VerticalStackLayout Spacing="20">

			<Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,0,0,10">
				<Button Grid.Column="0" 
            Text="📂 Load Preset" 
            Clicked="OnLoadPresetClicked" 
            BackgroundColor="#222233" 
            TextColor="#00FF66" 
            FontAttributes="Bold" 
            CornerRadius="8" 
            HeightRequest="40"/>

				<Button Grid.Column="1" 
            Text="💾 Save Preset" 
            Clicked="OnSavePresetClicked" 
            BackgroundColor="#00FF66" 
            TextColor="#121216" 
            FontAttributes="Bold" 
            CornerRadius="8" 
            HeightRequest="40"/>
			</Grid>

			<!-- HEADER / STATUS -->
			<Frame BackgroundColor="#1A1A22" BorderColor="#2E2E3E" Padding="12" CornerRadius="8">
				<Label Text="{Binding StatusText}" TextColor="#00FF66" FontSize="12" FontFamily="Monospace"/>
			</Frame>

			<!-- MIXER CHANNEL STRIPS -->
			<Label Text="CHANNEL MIXER" TextColor="#00FF66" FontSize="14" FontAttributes="Bold" />

			<VerticalStackLayout x:Name="MixerContainer" Spacing="10" />

			<!-- MASTER EFFECTS CHAIN -->
			<Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
				<Label Text="MASTER EFFECTS CHAIN" TextColor="#FF0055" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
				<Button Grid.Column="1" Text="➕ Add Master FX" Clicked="OnAddMasterEffectClicked" BackgroundColor="#222233" TextColor="#00FF66" HeightRequest="36" FontSize="11"/>
			</Grid>

			<VerticalStackLayout x:Name="MasterEffectsContainer" Spacing="10" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>