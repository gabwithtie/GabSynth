<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GabSynth.Models"
             x:Class="GabSynth.Views.InstrumentDatabasePage"
             Title="Instrument Database"
             BackgroundColor="#121216">

	<Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="16">

		<!-- HEADER & IMPORT ACTION -->
		<Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="10">
			<VerticalStackLayout VerticalOptions="Center">
				<Label Text="INSTRUMENT DATABASE" TextColor="#00FF66" FontSize="18" FontAttributes="Bold" />
				<Label Text="Manage and import local .sf2 SoundFonts" TextColor="#8888A0" FontSize="12" />
			</VerticalStackLayout>

			<Button Grid.Column="1"
                    Text="📥 Import .SF2"
                    Clicked="OnImportSoundFontClicked"
                    BackgroundColor="#00FF66"
                    TextColor="#121216"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    CornerRadius="8"
                    Padding="12,0" />
		</Grid>

		<!-- SOUNDFONT LISTING -->
		<RefreshView Grid.Row="1" x:Name="SoundFontRefreshView" Refreshing="OnRefreshTriggered">
			<CollectionView x:Name="SoundFontCollectionView"
                            IsGrouped="True"
                            SelectionMode="None">

				<CollectionView.EmptyView>
					<VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
						<Label Text="🎹 No SoundFonts found" TextColor="#8888A0" FontSize="16" HorizontalOptions="Center" />
						<Label Text="Tap 'Import .SF2' above to add files from Android downloads" TextColor="#555566" FontSize="12" HorizontalOptions="Center" />
					</VerticalStackLayout>
				</CollectionView.EmptyView>

				<CollectionView.GroupHeaderTemplate>
					<DataTemplate x:DataType="models:SoundFontGroup">
						<Label Text="{Binding Category}" FontSize="14" FontAttributes="Bold" TextColor="#FF0055" Padding="0,10,0,4"/>
					</DataTemplate>
				</CollectionView.GroupHeaderTemplate>

				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:SoundFontItem">
						<Frame Padding="12,10" 
                               CornerRadius="8" 
                               HasShadow="False" 
                               BackgroundColor="#1E1E28" 
                               BorderColor="#2E2E3E" 
                               Margin="0,3">
							<Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">

								<VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
									<Label Text="{Binding Name}" TextColor="White" FontSize="14" FontAttributes="Bold" />
									<Label Text="{Binding FullPath}" TextColor="#666680" FontSize="10" LineBreakMode="HeadTruncation" />
								</VerticalStackLayout>

								<Button Grid.Column="1"
                                        Text="🗑️"
                                        Clicked="OnDeleteSoundFontClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#331111"
                                        TextColor="#FF5555"
                                        HeightRequest="36"
                                        WidthRequest="38"
                                        Padding="0"
                                        CornerRadius="6"
                                        VerticalOptions="Center" />
							</Grid>
						</Frame>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

	</Grid>
</ContentPage>