<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GabSynth.Models"
             x:Class="GabSynth.Views.ChannelEditorPage"
             BackgroundColor="#121216">

	<ScrollView Padding="16">
		<VerticalStackLayout Spacing="20">

			<!-- CHANNEL TITLE -->
			<Label x:Name="ChannelTitleLabel" Text="CHANNEL 1 EDITOR" TextColor="#00FF66" FontSize="18" FontAttributes="Bold" />

			<!-- SOUNDFONT SELECTION -->
			<Label Text="ASSIGN SOUNDFONT INSTRUMENT" TextColor="#8888A0" FontSize="12" FontAttributes="Bold" />

			<CollectionView x:Name="SoundFontCollectionView"
                IsGrouped="True"
                SelectionMode="None"
                HeightRequest="220">
				<CollectionView.GroupHeaderTemplate>
					<DataTemplate x:DataType="models:SoundFontGroup">
						<Label Text="{Binding Category}" FontSize="14" FontAttributes="Bold" TextColor="#FF0055" Padding="0,6"/>
					</DataTemplate>
				</CollectionView.GroupHeaderTemplate>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:SoundFontItem">
						<Frame Padding="12,8" 
                   CornerRadius="6" 
                   HasShadow="False" 
                   BackgroundColor="#1E1E28" 
                   BorderColor="#2E2E3E" 
                   Margin="0,2">
							<!-- Visual State Triggers based on IsSelected -->
							<Frame.Triggers>
								<DataTrigger TargetType="Frame" Binding="{Binding IsSelected}" Value="True">
									<Setter Property="BorderColor" Value="#00FF66" />
									<Setter Property="BackgroundColor" Value="#1E2A22" />
								</DataTrigger>
								<DataTrigger TargetType="Frame" Binding="{Binding IsSelected}" Value="False">
									<Setter Property="BorderColor" Value="#2E2E3E" />
									<Setter Property="BackgroundColor" Value="#1E1E28" />
								</DataTrigger>
							</Frame.Triggers>

							<Frame.GestureRecognizers>
								<TapGestureRecognizer Tapped="OnSoundFontItemTapped" CommandParameter="{Binding .}" />
							</Frame.GestureRecognizers>

							<Label Text="{Binding Name}" TextColor="White" FontSize="13" InputTransparent="True" />
						</Frame>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<!-- CHANNEL EFFECTS -->
			<Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
				<Label Text="CHANNEL AUDIO EFFECTS" TextColor="#FF0055" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
				<Button Text="➕ Add Effect" Clicked="OnAddChannelEffectClicked" BackgroundColor="#222233" TextColor="#00FF66" HeightRequest="36" FontSize="11"/>
			</Grid>

			<VerticalStackLayout x:Name="ChannelEffectsContainer" Spacing="10" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>